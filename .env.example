# Copiar como .env en la raiz. Usar claves distintas y privadas.
# Formato Java properties: sin comillas; duplicar las barras inversas si se usan.
DB_URL=jdbc:mysql://127.0.0.1:3306/practicas_ubb?serverTimezone=UTC&allowPublicKeyRetrieval=true&sslMode=DISABLED
DB_USER=practicas_app
DB_PASSWORD=REEMPLAZAR_CLAVE_DESARROLLO
TEST_DB_URL=jdbc:mysql://127.0.0.1:3306/practicas_ubb_test?serverTimezone=UTC&allowPublicKeyRetrieval=true&sslMode=DISABLED
TEST_DB_USER=practicas_test
TEST_DB_PASSWORD=REEMPLAZAR_CLAVE_PRUEBAS
APP_PORT=8080
# Solo crea el primer coordinador si no existen usuarios. Completar antes del primer inicio.
BOOTSTRAP_ADMIN_EMAIL=coordinacion@example.com
BOOTSTRAP_ADMIN_PASSWORD=REEMPLAZAR_CLAVE_INICIAL

# Asistente con IA (opcional). Clave gratuita en https://aistudio.google.com. Sin clave, el asistente usa la busqueda por palabras clave.
GEMINI_API_KEY=
# Modelo de Gemini (opcional). Por defecto: gemini-flash-lite-latest
# GEMINI_MODEL=gemini-flash-lite-latest
